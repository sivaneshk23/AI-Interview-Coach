IBM_PROJECT_ID=
IBM_API_KEY=
IBM_REGION=jp-tok
MODEL_ID=ibm/granite-4-h-small

# Optional: set to protect all API endpoints with bearer-token auth.
# Leave empty (or remove) to disable authentication during local development.
# API_KEY=your-secret-key-here

# ── Production Foundation (Phase 1) ───────────────────────────────────

# JWT signing secret — MUST be set in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random per-process secret is used (dev only — sessions
# won't survive restarts).
# JWT_SECRET_KEY=your-jwt-secret-here

# JWT token expiry in minutes (default: 480 = 8 hours)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database URL (default: SQLite at data/app.db)
# For PostgreSQL production deployment:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///data/app.db